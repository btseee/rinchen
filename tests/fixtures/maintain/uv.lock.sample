# A HAND-WRITTEN sample in the shape of uv.lock (format version 1, revision 5), written from the
# structure of the repository's own lock file and never produced by uv. Six entries, five names:
#   alpha       a registry package with an sdist and a wheel (hashes are made-up digests)
#   Beta_Pkg    a name that is NOT in normal form: a reader must give it as beta-pkg
#   gamma       a version with a local label, from another registry: kept verbatim
#   delta       the same name and version twice, from two path sources (one wheel per platform)
#   rinchen     the editable project: no hash
version = 1
revision = 5
requires-python = "==3.14.*"
resolution-markers = [
    "sys_platform == 'win32'",
    "sys_platform == 'linux'",
]
supported-markers = [
    "sys_platform == 'win32'",
    "sys_platform == 'linux'",
]

[[package]]
name = "alpha"
version = "1.2.3"
source = { registry = "https://pypi.org/simple" }
sdist = { url = "https://files.example.invalid/packages/alpha-1.2.3.tar.gz", hash = "sha256:5b13055cceab12983ce8b9b86ed595304d0f7b73180eec4d62af20f93d8d1f53", size = 1000, upload-time = "2026-01-01T00:00:00.000Z" }
wheels = [
    { url = "https://files.example.invalid/packages/alpha-1.2.3-py3-none-any.whl", hash = "sha256:e731096b7c3519f2c9d37a8805be7b49609e6de09f8d8b5299975efd96371b59", size = 900, upload-time = "2026-01-01T00:00:00.000Z" },
]

[[package]]
name = "Beta_Pkg"
version = "2.0"
source = { registry = "https://pypi.org/simple" }
dependencies = [
    { name = "alpha" },
]
sdist = { url = "https://files.example.invalid/packages/beta_pkg-2.0.tar.gz", hash = "sha256:e4407474fa5308b5166656f3152f3d8b7f61da0ae23146e7a4d91803f1a7aa4f", size = 2000, upload-time = "2026-01-01T00:00:00.000Z" }

[[package]]
