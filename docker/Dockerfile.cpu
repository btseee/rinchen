# CPU image of `rinchen serve` (D11, ruling T20): the FastAPI service over an export of ours.
#
# Nobody built this file. The machine it was written on has no network and no authorisation to
# build, pull or run an image, so everything about the image itself is UNMEASURED:
#   - the base image tag (python:3.14-slim) and the uv image tag (ghcr.io/astral-sh/uv:0.13.7,
#     the version of the uv installed on the machine this was written on) were never looked up
#     in a registry;
#   - the image was never built: that `uv sync` succeeds in it (kiwipiepy-model has no wheel in
#     uv.lock and would build from its source distribution), the image size and its start time
#     are all unknown;
#   - how PID 1 stops (SIGTERM reaching `rinchen`, an exit status of 143) and a health check
#     inside a container were never run;
#   - no GPU image exists: this one is CPU only, hides the GPU and carries none of its wheels.
#
# What tests/unit/test_docker_files.py proves by reading this file: the base images and their
# tags, `uv sync --frozen --no-dev` with a skip list EQUAL to the torch and CUDA packages of
# uv.lock (serving imports none of them; the repository's own environment holds 3.2 GB of nvidia
# wheels and 1.2 GB of torch, which the list keeps out of the image), the vendored wheels the lock names copied before the sync, a user that is not
# root, the hidden GPU, a health check on /readyz, the exec form of ENTRYPOINT and CMD, and that
# every COPY source exists and the .dockerignore leaves it in the context.
#
# Build and run (the operator's steps, never run here), from the repository root:
#   docker compose -f docker/compose.serve.yaml up --build
# with RINCHEN_MODEL_DIR naming an export directory (default: models/tiny).

FROM python:3.14-slim AS build

# uv, from a pinned image tag (UNMEASURED: the tag is not verified).
COPY --from=ghcr.io/astral-sh/uv:0.13.7 /uv /usr/local/bin/uv

# The environment is /opt/venv and the runtime stage copies it whole. uv uses the image's own
# CPython 3.14 and never fetches another. Bytecode is compiled here because the runtime root
# file system is read-only.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

# uv.lock names two vendored wheels by path (pyonmttok and fasttext-wheel have no cp314 release
# upstream): vendor/ must be in place before any sync.
COPY pyproject.toml uv.lock README.md ./
COPY vendor ./vendor

# The dependencies first, so that a change of the sources does not reinstall them. The skip list
# is every torch, torch-*, torchcodec, triton, cuda-* and nvidia-* package of uv.lock.
RUN uv sync --frozen --no-dev --no-install-project \
    --no-install-package cuda-bindings \
    --no-install-package cuda-pathfinder \
    --no-install-package cuda-toolkit \
    --no-install-package nvidia-cublas \
    --no-install-package nvidia-cuda-cupti \
    --no-install-package nvidia-cuda-nvrtc \
    --no-install-package nvidia-cuda-runtime \
    --no-install-package nvidia-cudnn-cu13 \
    --no-install-package nvidia-cufft \
    --no-install-package nvidia-cufile \
    --no-install-package nvidia-curand \
    --no-install-package nvidia-cusolver \
    --no-install-package nvidia-cusparse \
    --no-install-package nvidia-cusparselt-cu13 \
    --no-install-package nvidia-nccl-cu13 \
    --no-install-package nvidia-nvjitlink \
    --no-install-package nvidia-nvshmem-cu13 \
    --no-install-package nvidia-nvtx \
    --no-install-package torch \
    --no-install-package torch-optimi \
    --no-install-package torchcodec \
    --no-install-package triton

# The project itself, as a wheel in the environment (not editable): the wheel force-includes
# configs/languages.yaml, so configs/ is needed here.
COPY src ./src
COPY configs ./configs
RUN uv sync --frozen --no-dev --no-editable \
    --no-install-package cuda-bindings \
    --no-install-package cuda-pathfinder \
    --no-install-package cuda-toolkit \
    --no-install-package nvidia-cublas \
    --no-install-package nvidia-cuda-cupti \
    --no-install-package nvidia-cuda-nvrtc \
    --no-install-package nvidia-cuda-runtime \
    --no-install-package nvidia-cudnn-cu13 \
    --no-install-package nvidia-cufft \
    --no-install-package nvidia-cufile \
    --no-install-package nvidia-curand \
    --no-install-package nvidia-cusolver \
    --no-install-package nvidia-cusparse \
    --no-install-package nvidia-cusparselt-cu13 \
    --no-install-package nvidia-nccl-cu13 \
    --no-install-package nvidia-nvjitlink \
    --no-install-package nvidia-nvshmem-cu13 \
    --no-install-package nvidia-nvtx \
    --no-install-package torch \
    --no-install-package torch-optimi \
    --no-install-package torchcodec \
    --no-install-package triton

FROM python:3.14-slim AS runtime

# An unprivileged user without a home, a password or a login shell.
RUN groupadd --gid 10001 rinchen \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin rinchen

ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
# CTranslate2 must not see a GPU even where the host has one.
ENV CUDA_VISIBLE_DEVICES=""

COPY --from=build /opt/venv /opt/venv

WORKDIR /app
COPY configs ./configs

USER 10001:10001

EXPOSE 8000

# The service is ready when /readyz answers 200 (the model is loaded and the queue is open); the
# standard library asks, so that no download tool is installed for it. The port is the one of
# CMD below: a command that changes --port must change this too.
HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/readyz', timeout=2).status == 200 else 1)"]

# Exec form, so that SIGTERM reaches `rinchen` and the service drains and exits. The model is
# mounted at /models/tiny (read only) by docker/compose.serve.yaml; the host is 0.0.0.0 here
# because the container's loopback is not reachable, and the compose file publishes the port on
# the host's loopback only.
ENTRYPOINT ["rinchen"]
CMD ["serve", "--model", "/models/tiny", "--config", "/app/configs/serve/tiny.yaml", "--host", "0.0.0.0", "--port", "8000"]
